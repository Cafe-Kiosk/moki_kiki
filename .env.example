# 이 파일을 .env 로 복사한 뒤 키를 채우세요. .env 는 깃에 올라가지 않습니다.
OPENAI_API_KEY=sk-...

# 개발 중 API 호출을 아예 막고 싶으면 1 로 둡니다 (화면 작업용)
MOKI_MOCK=0

# 공개 배포 보안 설정 (실제 값은 저장소에 올리지 마세요)
MOKI_PASSWORD=change-me
MOKI_STAFF_PASSWORD=staff-only-code
MOKI_STATE_SECRET=replace-with-a-long-random-secret

# 서버리스 OpenAI 호출 시간 예산
MOKI_OPENAI_TIMEOUT_SECONDS=15
MOKI_OPENAI_MAX_RETRIES=1
